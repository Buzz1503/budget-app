{
  // Type-checks the Health layer (src/health), body series (src/body) and sauna logic (src/sauna), all TypeScript. The rest
  // of the app is plain JSX and is not checked; Vite transpiles both.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"]
  },
  "include": ["src/health/**/*.ts", "src/body/**/*.ts", "src/sauna/**/*.ts", "src/sleep/**/*.ts", "src/env.d.ts"]
}
