{
  "name": "peptide-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/pin-qa.mjs",
    "build": "vite build --mode web",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run-all.mjs",
    "build:artifact": "VITE_NO_PWA=1 vite build --config vite.artifact.config.js && node scripts/build-artifact.mjs",
    "e2e:one": "node e2e/run-all.mjs",
    "pin-qa": "node scripts/pin-qa.mjs",
    "build:web": "npm run build",
    "prebuild:native": "node scripts/pin-qa.mjs",
    "build:native": "vite build --mode native",
    "cap:sync": "npm run build:native && cap sync ios",
    "cap:open": "cap open ios",
    "ios:assets": "node scripts/make-ios-assets.mjs && capacitor-assets generate --ios --iconBackgroundColor '#080a12' --iconBackgroundColorDark '#080a12' --splashBackgroundColor '#080a12' --splashBackgroundColorDark '#080a12'",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src/native src/components/native src/health src/body src/sauna src/components/health src/components/charts src/components/body src/components/sauna src/sleep src/components/sleep src/components/data src/lib/compute src/lib/pdf"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-health": "^8.11.12",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.6",
    "exifr": "^7.1.3",
    "framer-motion": "^12.0.0",
    "heic2any": "^0.0.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^4.10.38",
    "pepito-health": "file:plugins/pepito-health",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  }
}
